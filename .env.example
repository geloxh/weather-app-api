ENVIRONMENT=development

# Leave unset to use the built-in in-memory cache (fine for local dev).
# Set this once you run Redis (e.g. via docker-compose) for real caching.
REDIS_URL=redis://localhost:6379/0

# Cache TTLs in seconds (optional overrides)
CURRENT_CONDITIONS_TTL=600
HOURLY_FORECAST_TTL=1800
DAILY_FORECAST_TTL=3600